{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-frontend.sh\"",
            "statusMessage": "Formateando con Prettier (frontend)...",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
